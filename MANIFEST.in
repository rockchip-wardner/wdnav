# 源码分发包（sdist）需要额外带的文件
include README.md
include LICENSE
include MANIFEST.in
include pyproject.toml

# setuptools 的自定义 build hook（位于项目根）—— 必须在 sdist 里，否则
# 下游 `pip install sdist.tar.gz` 触发 build_py 时找不到 cmdclass 模块，
# 导致 wheel 包里没有 libshim_video.so。
include build_rkv.py

# C shim 源码：build hook 在 wheel build 时会现场编译，但 sdist 必须带
# 源码，否则纯源码安装路径拿不到 cshim_video_*.c。
include src/wdnav/cshim_video_encoder.c
include src/wdnav/cshim_video_decoder.c

# 类型 stub
include src/wdnav/py.typed
include src/wdnav/*.pyi

# 排除常见的临时/构建产物
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .pytest_cache
global-exclude *.egg-info
global-exclude build dist .tox .venv

# 排除 src/wdnav/lib/ 里手编 / 开发期拷贝的 native 文件 —— wheel 阶段会由
# build hook 现场编译出 libshim_video.so；librockchip_mpp.so* 是开发机器
# 上的预编译拷贝，不应随 wdnav 包一起发布。
exclude src/wdnav/lib/librockchip_mpp.so.0
exclude src/wdnav/lib/librockchip_mpp.so.1
exclude src/wdnav/lib/librockchip_mpp.so
exclude src/wdnav/lib/libshim_video.so
exclude src/wdnav/lib/rkv_video.so